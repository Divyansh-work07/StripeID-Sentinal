# Pench Tiger Reserve Intelligence Platform - Environment Variables
# Copy this file to .env before starting the application

# Google Gemini API Key for Vision & Multimodal Reasoning
PRIMARY_USER_KEY=YOUR_GEMINI_API_KEY_HERE
FALLBACK_SYSTEM_KEY=YOUR_FALLBACK_GEMINI_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Express Backend Server Port
PORT=5000

# Node Environment
NODE_ENV=development
